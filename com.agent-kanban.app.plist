<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd template: scripts/install_launchd.sh substitutes __INSTALL_PATH__
  and __HOME__ on `install`. Do not load this file with launchctl directly.
  PATH and LANG matter for run_command rules: launchd starts services with a
  minimal PATH (no claude/node) and no locale (non-ASCII args get mangled).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agent-kanban.app</string>

    <key>ProgramArguments</key>
    <array>
        <string>__INSTALL_PATH__/.venv/bin/python</string>
        <string>-m</string>
        <string>kanban_ui</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__INSTALL_PATH__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>KANBAN_HOST</key>
        <string>127.0.0.1</string>
        <key>KANBAN_PORT</key>
        <string>7777</string>
        <key>PATH</key>
        <string>__INSTALL_PATH__/.venv/bin:__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/agent-kanban/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/agent-kanban/stderr.log</string>
</dict>
</plist>
